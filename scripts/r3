window.historyPage=async function(){let q;if(['manager','director','admin'].includes(state.profile?.role)&&state.profile?.company_id)q=await sb.from('saletrening_sessions').select('id,employee_id,scenario_id,status,total_score,ai_summary,created_at,completed_at').eq('company_id',state.profile.company_id).order('created_at',{ascending:false}).limit(100);else q=await sb.from('saletrening_sessions').select('id,employee_id,scenario_id,status,total_score,ai_summary,created_at,completed_at').eq('employee_id',state.user.id).order('created_at',{ascending:false}).limit(100);const rows=q.data||[],names={};state.scenarios.forEach(z=>names[z.id]=z.title);return `<div class="top"><div><h2>История тренировок</h2><div class="muted">Нажмите на тренировку, чтобы открыть полный отчёт</div></div></div><div class="card" style="padding:0;overflow:hidden">${rows.length?`<table class="table"><thead><tr><th>Дата</th><th>Менеджер</th><th>Сценарий</th><th>Статус</th><th>Балл</th></tr></thead><tbody>${rows.map(x=>`<tr onclick="showTrainingReport('${x.id}')" style="cursor:pointer"><td>${new Date(x.created_at).toLocaleString('ru-RU')}</td><td>${x.employee_id===state.user.id?esc(state.profile.first_name||state.user.email):'Менеджер'}</td><td>${esc(names[x.scenario_id]||'Тренировка')}</td><td>${x.status==='completed'?'Завершена':'В процессе'}</td><td><b>${x.total_score??'—'}</b></td></tr>`).join('')}</tbody></table>`:'<div class="empty">История пока пуста.</div>'}</div>`};const oldPage=window.page;window.page=function(){if(state.report){$('page').innerHTML=reportPage();return}return oldPage.apply(this,arguments)};})();</script>